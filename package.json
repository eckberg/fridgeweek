{
  "name": "fridgeweek-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "A free web tool for making a printable weekly planner for the family fridge. Seven days on one page, filled in by hand, with picture marks so even kids who can't read yet can follow the week.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @fridgeweek/web dev",
    "build": "pnpm -r build",
    "deploy:cloudflare": "pnpm --filter @fridgeweek/web run deploy:cloudflare",
    "deploy:dry-run": "pnpm --filter @fridgeweek/web run deploy:dry-run",
    "test": "pnpm -r test",
    "test:visual": "pnpm -r test:visual",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "sample": "pnpm --filter @fridgeweek/core sample",
    "test:e2e": "pnpm -r test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "typescript": "^7.0.2"
  }
}
