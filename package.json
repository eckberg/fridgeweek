{
  "name": "fridgeweek-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Printable weekly sheet for the fridge, filled in by hand.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:visual": "pnpm -r test:visual",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "sample": "pnpm --filter @fridgeweek/core sample",
    "test:e2e": "pnpm -r test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "typescript": "^7.0.2"
  }
}
