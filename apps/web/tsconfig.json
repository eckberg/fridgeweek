{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.vue", "**/*.astro"],
  "exclude": ["dist", "node_modules"]
}
