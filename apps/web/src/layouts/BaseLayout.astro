---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  current?: 'about' | null;
  /** The builder fills the viewport, manages its own scrolling and has its own chrome. */
  fullHeight?: boolean;
  /** Keeps a page out of search results and out of the sitemap. */
  noindex?: boolean;
}

const { title, description, current = null, fullHeight = false, noindex = false } = Astro.props;
const fullTitle = title === 'Fridgeweek' ? title : `${title} · Fridgeweek`;

/**
 * Absolute URLs, which is what canonical links and social cards require.
 * `Astro.site` is the origin configured in `astro.config.mjs`; the trailing
 * slash is dropped so a page's own path is the only thing that varies.
 */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Fridgeweek" />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Fridgeweek: a printable weekly sheet for the fridge, filled in by hand."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      /*
       * The one third-party request the site makes. Cookieless and aggregate,
       * so there is nothing to consent to; `honor-dnt` means a reader who asks
       * not to be counted is not counted. Left out of development builds so
       * local work never lands in the numbers.
       */
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cdn.usefathom.com/script.js"
          data-site="MZJYVYIW"
          data-honor-dnt="true"
        />
      )
    }
    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-next-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class:list={{ 'full-height': fullHeight }}>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader current={current} variant={fullHeight ? 'app' : 'site'}>
      {/* The builder teleports its Print and Download buttons in here. */}
      {fullHeight && <div id="builder-actions" />}
    </SiteHeader>
    <main id="main">
      <slot />
    </main>
    {fullHeight ? <slot name="app-footer" /> : <SiteFooter />}
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  body.full-height {
    height: 100vh;
    overflow: hidden;
  }

  /*
   * Only where there is room to put panes side by side. Stacked on a narrow
   * screen the builder is one long page, and a body clamped to the viewport
   * with its overflow hidden is a page that cannot be scrolled at all.
   *
   * This override lives here rather than with the rest of the builder's
   * responsive CSS because it has to come after the rule above in the
   * cascade, and the two selectors are equally specific: a page's own
   * `is:global` styles are inlined into the head, above the stylesheet this
   * block ends up in, so from there it would lose.
   */
  @media (max-width: 900px) {
    body.full-height {
      height: auto;
      overflow: visible;
    }
  }

  main {
    flex: 1;
    min-height: 0;
  }

  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: top var(--transition);
  }

  .skip-link:focus {
    top: var(--space-4);
    color: var(--paper);
  }
</style>
