---
import { t } from '../i18n/index.js';
import GithubMark from './GithubMark.astro';
import Logo from './Logo.astro';

const repo = 'https://github.com/eckberg/fridgeweek';
---

<footer class="site-footer">
  <div class="top">
    <div class="brand-block">
      <a href="/" class="brand">
        <Logo size={26} />
        <span class="wordmark">Fridgeweek</span>
      </a>
      <p class="tagline">{t('site.tagline')}</p>
    </div>

    <nav aria-label={t('nav.secondaryLabel')}>
      <div class="column">
        <span class="eyebrow">{t('footer.sheetColumn')}</span>
        <a href="/sheet">{t('nav.builder')}</a>
        <a href="/#samples">{t('nav.samples')}</a>
        <a href="/#how">{t('nav.how')}</a>
      </div>
      <div class="column">
        <span class="eyebrow">{t('footer.projectColumn')}</span>
        <a href="/about">{t('footer.about')}</a>
        <a href={`${repo}/releases`} rel="noopener">{t('footer.changelog')}</a>
        <a href={`${repo}/issues`} rel="noopener">{t('footer.contact')}</a>
        <a href={repo} rel="noopener" class="with-mark">
          <GithubMark size={16} />{t('footer.source')}
        </a>
      </div>
    </nav>
  </div>

  <div class="bottom">
    <p class="pitch">
      {t('footer.pitch')} <a href={repo} rel="noopener">{t('footer.pitchLink')}</a>.
    </p>
    <a href={repo} rel="noopener" class="repo-button">
      <GithubMark size={16} />eckberg/fridgeweek
    </a>
  </div>

  <p class="legal mono">
    {t('footer.legal')} · <a href="/about#credits">{t('footer.credits')}</a>
  </p>
</footer>

<style>
  .site-footer {
    padding: 40px var(--space-6) 56px;
    background: var(--ink);
    color: var(--paper);
  }

  .top,
  .bottom,
  .legal {
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--paper);
    text-decoration: none;
  }

  .wordmark {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tagline {
    max-width: 34ch;
    font-size: 15px;
    color: #b9b4ad;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .column .eyebrow {
    color: #8d8880;
    margin-bottom: 2px;
  }

  .column a {
    font-size: 15px;
    color: var(--paper);
    text-decoration: none;
  }

  .column a:hover {
    color: var(--accent-soft);
  }

  .with-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 28px;
    margin-top: var(--space-6);
    padding-top: 20px;
    border-top: 1px solid #444444;
  }

  .pitch {
    max-width: 62ch;
    font-size: 15px;
    color: #b9b4ad;
  }

  .pitch a {
    color: var(--paper);
    font-weight: 700;
  }

  .pitch a:hover {
    color: var(--accent-soft);
  }

  .repo-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 18px;
    border: 1px solid #444444;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 700;
    color: var(--paper);
    text-decoration: none;
    white-space: nowrap;
  }

  .repo-button:hover {
    border-color: var(--paper);
    color: var(--paper);
  }

  .legal {
    margin-top: var(--space-5);
    font-size: 12px;
    color: #8d8880;
  }

  .legal a {
    color: #b9b4ad;
  }

  .legal a:hover {
    color: var(--paper);
  }

  @media (max-width: 720px) {
    .site-footer {
      padding: var(--space-6) var(--space-4) 40px;
    }

    nav {
      gap: var(--space-6);
    }
  }
</style>
