---
import { t } from '../i18n/index.js';
import GithubMark from './GithubMark.astro';
---

<footer class="site-footer">
  <p class="note">
    {t('footer.note')} &mdash; <a href="/about#privacy">{t('footer.privacyLink')}</a>.
  </p>
  <nav aria-label={t('nav.secondaryLabel')}>
    <a href="/about">{t('footer.about')}</a>
    <a href="/about#what">{t('footer.what')}</a>
    <a href="https://github.com/eckberg/fridgeweek" rel="noopener" class="source">
      <GithubMark size={16} /> {t('nav.source')}
    </a>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border-top: 1px solid var(--border);
    background: var(--paper);
  }

  .note {
    font-size: 14px;
    color: var(--ink-soft);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-size: 14px;
    font-weight: 700;
  }

  nav a {
    color: var(--ink);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }

  .source {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
