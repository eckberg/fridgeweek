---
import { computeLayout, renderSvg, resolveConfig, type SheetConfigInput } from '@fridgeweek/core';
import { renderFilledOverlay, type SampleEntry } from '../../lib/filledSample.js';

/**
 * A real sheet, rendered at build time by the same function the printer uses.
 * Nothing here is a mock-up: what the page shows is what comes out of the tray.
 *
 * `entries` adds a second layer over that sheet, in the same coordinates,
 * holding what somebody wrote on it. The sheet under it is untouched — the
 * writing is what the pen does afterwards, which is the half of the product
 * an empty grid cannot show.
 */
interface Props {
  config: SheetConfigInput;
  caption?: string;
  /** Distinguishes the inline `<symbol>` ids when several sheets share a page. */
  id: string;
  /** A week written onto the sheet. Omit for a blank one. */
  entries?: SampleEntry[];
}

const { config, caption, id, entries } = Astro.props;
const resolved = resolveConfig(config);
const svg = renderSvg(resolved, { idPrefix: id });
const ink = entries?.length ? renderFilledOverlay(computeLayout(resolved), entries) : '';
---

<figure class="sample">
  <div class="paper">
    <Fragment set:html={svg} />
    {ink && <Fragment set:html={ink} />}
  </div>
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .sample {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .paper {
    position: relative;
    background: var(--white);
    box-shadow: var(--shadow-sheet);
  }

  .paper :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Laid exactly over the sheet, sharing its viewBox, so a millimetre in the
     layout is the same millimetre here whatever the sheet is scaled to. */
  .paper :global(svg.ink) {
    position: absolute;
    inset: 0;
    height: 100%;
    font-family: var(--font-hand);
    font-weight: 600;
    pointer-events: none;
  }

  figcaption {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
