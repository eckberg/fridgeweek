---
import { renderSvg, resolveConfig, type SheetConfigInput } from '@fridgeweek/core';

/**
 * A real sheet, rendered at build time by the same function the printer uses.
 * Nothing here is a mock-up: what the page shows is what comes out of the tray.
 */
interface Props {
  config: SheetConfigInput;
  caption?: string;
  /** Distinguishes the inline `<symbol>` ids when several sheets share a page. */
  id: string;
}

const { config, caption, id } = Astro.props;
const svg = renderSvg(resolveConfig(config), { idPrefix: id });
---

<figure class="sample">
  <div class="paper" set:html={svg} />
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .sample {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .paper {
    background: var(--white);
    box-shadow: var(--shadow-sheet);
  }

  .paper :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
