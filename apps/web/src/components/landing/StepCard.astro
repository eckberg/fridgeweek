---
interface Props {
  number: string;
  title: string;
  /** Short monospaced facts listed under the body, e.g. paper sizes. */
  tags?: string[];
}

const { number, title, tags = [] } = Astro.props;
---

<article class="step">
  <p class="mono number">{number}</p>
  <h3>{title}</h3>
  <p class="body"><slot /></p>
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li class="mono">{tag}</li>
        ))}
      </ul>
    )
  }
  <slot name="extra" />
</article>

<style>
  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    background: var(--white);
    border-radius: 12px;
  }

  .number {
    color: var(--accent);
    font-weight: 500;
  }

  h3 {
    font-size: 21px;
  }

  .body {
    font-size: 16px;
    color: var(--ink-soft);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
    list-style: none;
  }

  .tags li {
    padding: 9px 11px;
    border-radius: var(--radius-pill);
    background: var(--paper-tint);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
