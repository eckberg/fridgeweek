---
/**
 * The Fridgeweek mark: a folded paper bird. Flat planes, straight creases, no
 * gradients, so it survives being printed in black on any paper and still
 * reads at 16 px.
 */
interface Props {
  size?: number;
  /** `mono` draws the mark in a single ink for print and favicons. */
  variant?: 'colour' | 'mono';
  title?: string;
}

const { size = 32, variant = 'colour', title = 'Fridgeweek' } = Astro.props;

const planes =
  variant === 'colour'
    ? ['#f5c5ab', '#e08256', '#a8471b', '#ce6234']
    : ['none', 'none', 'currentColor', 'none'];
const creaseColour = variant === 'colour' ? '#fcfaf6' : 'currentColor';
const outline = variant === 'mono' ? 'currentColor' : 'none';
---

<svg
  viewBox="0 0 64 64"
  width={size}
  height={size}
  role="img"
  aria-label={title}
  class="logo"
>
  <polygon points="8,48 32,12 32,48" fill={planes[0]} stroke={outline} stroke-width="2" />
  <polygon points="32,12 52,48 32,48" fill={planes[1]} stroke={outline} stroke-width="2" />
  <polygon points="32,12 60,17 37,27" fill={planes[2]} stroke={outline} stroke-width="2" />
  <polygon points="8,48 16,58 30,48" fill={planes[3]} stroke={outline} stroke-width="2" />
  <line x1="32" y1="12" x2="32" y2="48" stroke={creaseColour} stroke-width="1.1" />
</svg>

<style>
  .logo {
    display: block;
    flex: none;
  }
</style>
