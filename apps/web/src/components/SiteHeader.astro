---
import { t } from '../i18n/index.js';
import GithubMark from './GithubMark.astro';
import Logo from './Logo.astro';

interface Props {
  /** Which navigation entry to mark as the current page. */
  current?: 'about' | null;
  /**
   * The builder replaces the marketing navigation with its own actions and
   * sits tighter, because the sheet below it needs the height.
   */
  variant?: 'site' | 'app';
}

const { current = null, variant = 'site' } = Astro.props;
const repo = 'https://github.com/eckberg/fridgeweek';
---

<header class:list={['site-header', variant]}>
  <a href="/" class="brand">
    <Logo size={variant === 'app' ? 26 : 30} />
    <span class="wordmark">Fridgeweek</span>
  </a>

  {
    variant === 'site' && (
      <nav aria-label={t('nav.mainLabel')}>
        <a href="/#how" class="jump">
          {t('nav.how')}
        </a>
        <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>
          {t('nav.about')}
        </a>
        <a href={repo} rel="noopener" class="icon" aria-label={t('nav.github')}>
          <GithubMark size={21} />
        </a>
        <a href="/sheet" class="cta">
          {t('nav.builder')}
        </a>
      </nav>
    )
  }

  <slot />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: 20px var(--space-6);
    border-bottom: 1px solid var(--border);
    background: var(--paper);
  }

  .site-header.app {
    gap: var(--space-4);
    padding: 14px var(--space-5);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark {
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .app .wordmark {
    font-size: 19px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  nav a {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  /*
   * Icon-only, so it is a square 44 px target instead of the text links'
   * padding. Qualified for the same reason as .cta below.
   */
  nav a.icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
  }

  nav a[aria-current='page'] {
    background: var(--paper-tint);
    color: var(--ink);
  }

  /*
   * The brand's mid orange is the button colour in the design sketches, but at
   * 3.7:1 against paper it fails contrast for button text. The darker accent is
   * the same family, is already the link colour, and passes at 5.7:1.
   *
   * The selector is qualified because Astro scopes every compound in a
   * selector, which lifts `nav a` above a bare `.cta`.
   */
  nav a.cta {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 20px;
    background: var(--accent);
    color: var(--paper);
    font-weight: 800;
  }

  nav a.cta:hover {
    background: var(--accent-deep);
    color: var(--paper);
  }

  @media (max-width: 720px) {
    .site-header {
      gap: var(--space-3);
      padding: 14px var(--space-4);
    }

    .wordmark {
      display: none;
    }

    nav {
      gap: 2px;
    }

    nav a {
      padding: 10px;
      font-size: 14px;
    }

    nav a.cta {
      padding: 0 14px;
    }

    /* In-page jumps only reach sections you can also scroll to, so they are
       the first thing to go when the header runs out of room. */
    .jump {
      display: none;
    }
  }
</style>
