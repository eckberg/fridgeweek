---
import { t } from '../i18n/index.js';
import Logo from './Logo.astro';

interface Props {
  /** Which navigation entry to mark as the current page. */
  current?: 'builder' | 'about' | null;
  /** The builder puts its own actions in the header. */
  compact?: boolean;
}

const { current = null, compact = false } = Astro.props;
---

<header class:list={['site-header', { compact }]}>
  <a href="/" class="brand">
    <Logo size={28} />
    <span class="wordmark">Fridgeweek</span>
  </a>
  <nav aria-label={t('nav.mainLabel')}>
    <a href="/sheet" aria-current={current === 'builder' ? 'page' : undefined}>{t('nav.builder')}</a>
    <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>{t('nav.about')}</a>
    <a href="https://github.com/eckberg/fridgeweek" rel="noopener">{t('nav.source')}</a>
  </nav>
  <slot />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-height);
    padding: 0 var(--space-5);
    border-bottom: 1px solid var(--border);
    background: var(--paper);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    gap: var(--space-4);
    font-size: 15px;
  }

  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    padding: var(--space-1) 0;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  @media (max-width: 640px) {
    .site-header {
      gap: var(--space-3);
      padding: 0 var(--space-4);
    }

    .wordmark {
      display: none;
    }
  }
</style>
