---
import { SHEET_LOCALES } from '@fridgeweek/core';
import SheetSample from '../components/landing/SheetSample.astro';
import StepCard from '../components/landing/StepCard.astro';
import { t } from '../i18n/index.js';
import BaseLayout from '../layouts/BaseLayout.astro';

/** What the builder can set, listed as the sheet's own vocabulary. */
const choices = [
  { label: 'People', value: '1 to 6' },
  { label: 'Marks', value: 'symbol or initial' },
  { label: 'Lines per day', value: '1 to 4, default 3' },
  { label: 'Family mark', value: 'house, on by default' },
  { label: 'Header', value: 'week no. · range · legend' },
  { label: 'Week starting', value: 'blank, or a date' },
  { label: 'Weekends', value: 'outline or plain' },
  { label: 'Paper', value: 'A4 or Letter · 5 to 20 mm' },
  { label: 'Language', value: `${SHEET_LOCALES.length}, in your own` },
];

const family = [
  { name: 'Ava', symbol: 'unicorn' as const },
  { name: 'Harry', symbol: 'dinosaur' as const },
  { name: 'Sara', symbol: 'flower' as const },
  { name: 'Karl', symbol: 'rocket' as const },
];
---

<BaseLayout title="Fridgeweek" description={t('site.tagline')}>
  <section class="hero">
    <p class="eyebrow">Paper · a pen · seven rows</p>
    <h1>{t('landing.heroTitle')}</h1>
    <p class="lede">{t('landing.heroBody')}</p>
    <div class="hero-actions">
      <a class="cta" href="/sheet">{t('landing.heroCta')}</a>
      <a class="cta-quiet" href="#samples">{t('landing.heroSecondary')}</a>
    </div>
    <p class="mono facts">
      Free · MIT · A4 and Letter · {SHEET_LOCALES.length} languages · no account
    </p>
  </section>

  <section class="band" id="how">
    <div class="band-inner">
      <p class="eyebrow">{t('landing.howEyebrow')}</p>
      <h2>{t('landing.howTitle')}</h2>
      <div class="steps">
        <StepCard number="01" title={t('landing.step1Title')}>
          {t('landing.step1Body')}
        </StepCard>
        <StepCard
          number="02"
          title={t('landing.step2Title')}
          tags={['A4', 'Letter', '1–20 copies', 'Mono']}
        >
          {t('landing.step2Body')}
        </StepCard>
        <StepCard number="03" title={t('landing.step3Title')}>
          {t('landing.step3Body')}
        </StepCard>
      </div>
    </div>
  </section>

  <section class="section" id="what-you-set">
    <p class="eyebrow">What you set</p>
    <h2>Nine choices, and the layout does the arithmetic</h2>
    <p class="lede">
      Fridgeweek never shrinks a line behind your back. If a configuration will not fit on the
      paper, it says so and tells you exactly what to change.
    </p>
    <ul class="choices">
      {
        choices.map((choice) => (
          <li>
            <span class="choice-label">{choice.label}</span>
            <span class="mono choice-value">{choice.value}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band" id="samples">
    <div class="band-inner">
      <p class="eyebrow">Samples</p>
      <h2>Two real sheets, exactly as they print</h2>
      <p class="lede">
        Both are rendered by the same function the printer receives, at build time. Start from
        one of these.
      </p>
      <div class="samples">
        <SheetSample
          caption="en-GB · A4 · blank dates · 2 people and the house"
          config={{ locale: 'en-GB', people: family.slice(0, 2) }}
        />
        <SheetSample
          caption="sv-SE · A4 · week 37 dated · 4 people and the house"
          config={{ locale: 'sv-SE', people: family, weekStarting: '2026-09-07' }}
        />
      </div>
    </div>
  </section>

  <section class="section closing">
    <h2>{t('landing.ctaTitle')}</h2>
    <p class="lede">{t('landing.ctaBody')}</p>
    <a class="cta" href="/sheet">{t('landing.heroCta')}</a>
  </section>
</BaseLayout>

<style>
  .hero,
  .section,
  .band-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-8) var(--space-5);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-top: var(--space-9);
  }

  .lede {
    max-width: 62ch;
    font-size: 18px;
    color: var(--ink-soft);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .cta {
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .cta-quiet {
    font-weight: 700;
    text-decoration: none;
  }

  .cta-quiet:hover {
    text-decoration: underline;
  }

  .facts {
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11px;
  }

  .band {
    background: var(--paper-sunk);
    border-block: 1px solid var(--border);
  }

  .section h2,
  .band-inner h2 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  /* Nine choices, so three by three reads as one block rather than a ragged list. */
  .choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    max-width: 1000px;
    gap: var(--space-1) var(--space-5);
    margin-top: var(--space-5);
    list-style: none;
  }

  .choices li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
  }

  .choice-label {
    font-weight: 700;
  }

  .choice-value {
    text-align: right;
  }

  .samples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-5);
  }

  .closing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  @media (max-width: 640px) {
    .hero,
    .section,
    .band-inner {
      padding: var(--space-7) var(--space-4);
    }
  }
</style>
