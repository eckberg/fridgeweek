---
import { SHEET_LOCALES } from '@fridgeweek/core';
import RingLine from '../components/landing/RingLine.astro';
import SheetSample from '../components/landing/SheetSample.astro';
import StepCard from '../components/landing/StepCard.astro';
import SymbolRow from '../components/landing/SymbolRow.astro';
import { t } from '../i18n/index.js';
import BaseLayout from '../layouts/BaseLayout.astro';

/** What the builder can set, in the sheet's own vocabulary. */
const choices = [
  { label: 'People', value: '1 to 6' },
  { label: 'Marks', value: 'symbol or initial' },
  { label: 'Lines per day', value: '1 to 4, default 3' },
  { label: 'Family mark', value: 'house, on by default' },
  { label: 'Header', value: 'week no. · range · legend' },
  { label: 'Week starting', value: 'blank, or a date' },
  { label: 'Weekends', value: 'outline or plain' },
  { label: 'Paper', value: 'A4 or Letter · 5 to 20 mm' },
  { label: 'Language', value: `${SHEET_LOCALES.length}, and Intl for the rest` },
];

const family = [
  { name: 'Ava', symbol: 'unicorn' as const },
  { name: 'Harry', symbol: 'dinosaur' as const },
  { name: 'Sara', symbol: 'flower' as const },
  { name: 'Karl', symbol: 'rocket' as const },
];

const entries = ['swimming kit', 'preschool closed', 'football at five', 'grandma picks up'];
---

<BaseLayout title="Fridgeweek" description={t('site.tagline')}>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{t('landing.heroEyebrow')}</p>
      <h1>{t('landing.heroTitle')}</h1>
      <p class="lede">{t('landing.heroBody')}</p>
      <div class="hero-actions">
        <a class="button primary" href="/sheet">{t('landing.heroCta')}</a>
        <a class="button quiet" href="#samples">{t('landing.heroSecondary')}</a>
      </div>
      <p class="mono facts">{t('landing.heroFacts', { count: SHEET_LOCALES.length })}</p>
    </div>

    <div class="hero-frame">
      <SheetSample id="hero" config={{ locale: 'sv-SE', people: family, weekStarting: '2026-09-07' }} />
    </div>
  </section>

  <section class="band tint" id="how">
    <div class="inner">
      <header class="section-head">
        <p class="eyebrow">{t('landing.howEyebrow')}</p>
        <h2>{t('landing.howTitle')}</h2>
      </header>

      <div class="steps">
        <StepCard number="01" title={t('landing.step1Title')}>
          {t('landing.step1Body')}
          <SymbolRow slot="extra" ids={['cat', 'rocket', 'flower', 'house']} />
        </StepCard>

        <StepCard
          number="02"
          title={t('landing.step2Title')}
          tags={['A4', 'Letter', '1–20 copies', 'Mono']}
        >
          {t('landing.step2Body')}
        </StepCard>

        <StepCard number="03" title={t('landing.step3Title')}>
          {t('landing.step3Body')}
          <RingLine slot="extra" text="swimming kit" ruled />
        </StepCard>
      </div>
    </div>
  </section>

  <section class="band" id="what-you-set">
    <div class="inner">
      <header class="section-head">
        <p class="eyebrow">{t('landing.setEyebrow')}</p>
        <h2>{t('landing.setTitle')}</h2>
        <p class="lede narrow">{t('landing.setBody')}</p>
      </header>

      <ul class="choices">
        {
          choices.map((choice) => (
            <li>
              <span class="choice-label">{choice.label}</span>
              <span class="mono choice-value">{choice.value}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band desk" id="samples">
    <div class="inner">
      <header class="section-head row">
        <div>
          <p class="eyebrow">{t('landing.samplesEyebrow')}</p>
          <h2>{t('landing.samplesTitle')}</h2>
        </div>
        <a class="button primary" href="/sheet">{t('landing.samplesCta')}</a>
      </header>

      <div class="samples">
        <SheetSample
          id="sa"
          caption="en-GB · A4 · blank dates · 2 people and the house"
          config={{ locale: 'en-GB', people: family.slice(0, 2) }}
        />
        <SheetSample
          id="sb"
          caption="sv-SE · A4 · week 37 dated · 4 people and the house"
          config={{ locale: 'sv-SE', people: family, weekStarting: '2026-09-07' }}
        />

        <div class="ends-up">
          <h3>{t('landing.endsUpTitle')}</h3>
          <div class="entries">
            {entries.map((entry) => <RingLine text={entry} />)}
          </div>
          <p class="note">{t('landing.endsUpBody')}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .inner,
  .hero {
    max-width: var(--page-max);
    margin: 0 auto;
  }

  /* Hero: the words on the left, a real sheet framed on the right. */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-7);
    padding: 64px var(--space-6) 56px;
  }

  .hero-text {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  h1 {
    font-size: clamp(38px, 5.4vw, 60px);
  }

  .lede {
    max-width: 52ch;
    font-size: 19px;
    color: var(--ink-soft);
  }

  .narrow {
    max-width: 46ch;
    font-size: 16px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-frame {
    flex: 0 1 420px;
    display: flex;
    justify-content: center;
    padding: 36px;
    border-radius: 16px;
    background: var(--desk);
  }

  .hero-frame :global(.sample) {
    max-width: 360px;
  }

  .facts {
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    height: 48px;
    border-radius: var(--radius-md);
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
  }

  /* See SiteHeader: the mid orange fails contrast for button text. */
  .primary {
    padding: 0 26px;
    background: var(--accent);
    color: var(--paper);
  }

  .primary:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .quiet {
    padding: 0 22px;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
  }

  .quiet:hover {
    border-color: var(--accent-mid);
    color: var(--accent);
  }

  .band {
    padding: 56px var(--space-6);
  }

  .band.tint {
    background: var(--paper-tint);
    border-block: 1px solid var(--border);
  }

  .band.desk {
    background: var(--desk);
    border-top: 1px solid var(--border);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
  }

  .section-head.row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .section-head h2 {
    font-size: clamp(26px, 3.4vw, 38px);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 20px;
  }

  .choices {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    list-style: none;
  }

  .choices li {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 16px;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .choice-label {
    font-size: 15px;
    font-weight: 700;
  }

  .samples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
    align-items: start;
  }

  .ends-up {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    background: var(--paper);
    border-radius: 12px;
  }

  .ends-up h3 {
    font-size: 20px;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .note {
    font-size: 15px;
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .hero {
      padding: 40px var(--space-4);
      gap: var(--space-6);
    }

    .band {
      padding: 40px var(--space-4);
    }

    .hero-frame {
      padding: 20px;
    }
  }
</style>
