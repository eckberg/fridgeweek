---
import GithubMark from '../components/GithubMark.astro';
import { t } from '../i18n/index.js';
import BaseLayout from '../layouts/BaseLayout.astro';

const repo = 'https://github.com/eckberg/fridgeweek';

const sections = [
  { id: 'about', label: 'About' },
  { id: 'paper', label: 'Why paper' },
  { id: 'privacy', label: 'Privacy' },
  { id: 'terms', label: 'Terms' },
  { id: 'credits', label: 'Licence and credits' },
  { id: 'contact', label: 'Contact' },
];

const principles = ['Equal day heights', 'Uppercase names', 'Outline weekends', 'Mono print'];

/** What actually happens to anything you type, stated as a table of facts. */
const dataFacts = [
  ['state', 'URL hash + localStorage, in your browser'],
  ['server storage', 'none'],
  ['analytics', 'Fathom, cookieless and aggregate'],
  ['cookies', 'none, so no consent banner'],
  ['third-party requests', 'the analytics script; fonts and icons are bundled'],
];

const credits = [
  {
    name: 'Fridgeweek code',
    kind: 'This site and the sheets it makes',
    licence: 'MIT',
    href: `${repo}/blob/main/LICENSE`,
  },
  {
    name: 'Atkinson Hyperlegible Next',
    kind: 'The typeface, on screen and on paper',
    licence: 'SIL OFL 1.1',
    href: 'https://github.com/googlefonts/atkinson-hyperlegible-next',
  },
  {
    name: 'IBM Plex Mono',
    kind: 'The typeface for measurements and codes',
    licence: 'SIL OFL 1.1',
    href: 'https://github.com/IBM/plex',
  },
  {
    name: 'Caveat',
    kind: 'One handwritten line, on the front page',
    licence: 'SIL OFL 1.1',
    href: 'https://github.com/googlefonts/caveat',
  },
  {
    name: 'Lucide icons',
    kind: 'The symbols on the sheet',
    licence: 'ISC',
    href: 'https://lucide.dev',
  },
  {
    name: 'Fathom Analytics',
    kind: 'Visitor numbers',
    licence: 'Hosted service',
    href: 'https://usefathom.com',
  },
];
---

<BaseLayout title={t('meta.aboutTitle')} description={t('meta.aboutDescription')} current="about">
  <div class="page">
    <nav class="toc" aria-label="On this page">
      <span class="eyebrow">On this page</span>
      {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
    </nav>

    <article class="body">
      <header class="intro">
        <h1>About Fridgeweek</h1>
        <p class="lede">
          Fridgeweek turns a handful of parameters into a print-ready weekly sheet for the whole
          family: one week, seven days top to bottom, filled in by hand and stuck on the fridge
          where everyone can see it &mdash; including the children who cannot read yet.
        </p>
      </header>

      <section id="about">
        <h2>About</h2>
        <p>
          It was written for households with pre-school and early-school children who were already
          drawing this sheet by hand every week and wanted to stop redrawing the skeleton.
        </p>
        <p>
          It is a small open-source project, not a company and not a product with a plan. Every
          line of it is public, along with a{' '}
          <a href={`${repo}/blob/main/DESIGN.md`} rel="noopener">design document</a> recording
          every decision and the reason behind it &mdash; including the things Fridgeweek will
          deliberately never do, which is what keeps it this small.
        </p>
        <div class="button-row">
          <a class="button dark" href={repo} rel="noopener">
            <GithubMark size={16} />eckberg/fridgeweek
          </a>
        </div>
      </section>

      <section id="paper">
        <h2>Why paper</h2>
        <p>
          A sheet on the fridge is visible to everyone in the house, including the people who
          cannot read yet and the ones who do not have a phone. It never needs charging, it does
          not notify anyone, and a four-year-old can point at Thursday. Every day is the same
          height so today can be found by counting rows, weekday names are set in capitals because
          pre-readers recognise capitals first, and weekend names are drawn as outline letters so
          they can be coloured in.
        </p>
        <ul class="pills">
          {principles.map((principle) => <li class="mono">{principle}</li>)}
        </ul>
      </section>

      <section id="privacy">
        <h2>Privacy</h2>
        <p>
          When you use this site to make a sheet, everything you type stays in your browser. There
          are no accounts and no cookies. The names and symbols are encoded in the page's own
          address, so you can bookmark or share a configuration, and kept in local storage so the
          page remembers it next time. Clearing your browser data deletes them.
        </p>
        <p>
          One exception, and only if you ask for it: choosing <strong>Download PDF</strong> sends
          your configuration to a server that draws the same sheet and sends the file back.
          Nothing is stored there and nothing is kept after the file is sent. Printing from your
          browser instead sends nothing anywhere and works offline.
        </p>

        <h3>Visitor numbers</h3>
        <p>
          Counted with Fathom Analytics: page views, plus two counters for sheets printed and
          PDFs downloaded. It is cookieless and aggregate &mdash; no profiles, nothing that
          follows you between sites, Do Not Track respected, and nothing you type is ever
          included.
        </p>

        <dl class="facts">
          {
            dataFacts.map(([key, value]) => (
              <div class="fact">
                <dt class="mono">{key}</dt>
                <dd class="mono">{value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="terms">
        <h2>Terms</h2>
        <p>
          Use it, print it, put it on your fridge, hand it to a school, translate it, fork it. The
          code is MIT licensed, which is the whole of the legal position. The sheets you print are
          yours and nobody claims anything in them.
        </p>
        <p>
          There is no warranty: the software is provided as is. Printers are printers. Check a
          sheet before you print twenty of them.
        </p>
      </section>

      <section id="credits">
        <h2>Licence and credits</h2>
        <div class="credits">
          {
            credits.map((credit) => (
              <div class="credit">
                <div class="what">
                  <a href={credit.href} rel="noopener">
                    {credit.name}
                  </a>
                  <span class="mono kind">{credit.kind}</span>
                </div>
                <span class="mono">{credit.licence}</span>
              </div>
            ))
          }
        </div>
        <p>
          Neither the font licence nor the icon licence puts any attribution requirement on a
          sheet you print. Full notices are in{' '}
          <a href={`${repo}/blob/main/THIRD_PARTY_NOTICES.md`} rel="noopener">
            THIRD_PARTY_NOTICES.md
          </a>.
        </p>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>
          Bugs, fixes and small improvements are welcome on the repository. The two contributions
          wanted most are a new language and a new symbol, and both are a step-by-step recipe that
          does not require understanding the layout engine.
        </p>
        <div class="button-row">
          <a class="button dark" href={`${repo}/issues/new`} rel="noopener">
            <GithubMark size={16} />Open an issue
          </a>
          <a
            class="button outline"
            href={`${repo}/blob/main/CONTRIBUTING.md#adding-a-language`}
            rel="noopener"
          >
            Add a language
          </a>
          <a
            class="button outline"
            href={`${repo}/blob/main/CONTRIBUTING.md#adding-a-symbol`}
            rel="noopener"
          >
            Add a symbol
          </a>
        </div>
      </section>

    </article>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 56px;
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px var(--space-6) 72px;
  }

  /* The page is one long read, so the map of it stays in view. */
  .toc {
    position: sticky;
    top: var(--space-5);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc .eyebrow {
    margin-bottom: var(--space-2);
  }

  .toc a {
    padding: 9px 0;
    font-size: 15px;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h1 {
    font-size: clamp(34px, 4.6vw, 48px);
  }

  .lede {
    max-width: 60ch;
    font-size: 19px;
    color: var(--ink-soft);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 36px;
    padding-top: 36px;
    border-top: 1px solid var(--border);
    scroll-margin-top: var(--space-5);
  }

  h2 {
    font-size: 27px;
  }

  h3 {
    margin-top: var(--space-4);
    font-size: 19px;
  }

  p {
    max-width: 66ch;
    font-size: 17px;
    color: var(--ink-soft);
  }

  strong {
    color: var(--ink);
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: var(--space-1) 0 var(--space-2);
    max-width: 66ch;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 16px;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .dark {
    background: var(--ink);
    color: var(--paper);
  }

  .dark:hover {
    background: var(--accent);
    color: var(--paper);
  }

  .outline {
    padding: 0 14px;
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .outline:hover {
    border-color: var(--accent-mid);
    color: var(--accent);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: var(--space-1);
    list-style: none;
  }

  .pills li {
    padding: 9px 12px;
    border-radius: var(--radius-pill);
    background: var(--paper-tint);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 66ch;
    margin: var(--space-2) 0 0;
    padding: 20px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .fact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 13px;
  }

  .fact dt {
    min-width: 11rem;
    color: var(--ink-faint);
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
  }

  .credits {
    display: flex;
    flex-direction: column;
    max-width: 66ch;
  }

  .credit {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .what {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .credit a {
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
  }

  .credit span {
    color: var(--ink-faint);
  }

  
  
  
  
  
  
  @media (max-width: 860px) {
    .page {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      padding: 40px var(--space-4) 56px;
    }

    .toc {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-4);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--border);
    }

    .toc .eyebrow {
      flex-basis: 100%;
      margin-bottom: 0;
    }
  }
</style>
