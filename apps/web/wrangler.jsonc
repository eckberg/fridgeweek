{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Change this and the route below if you deploy your own copy.
  "name": "fridgeweek",

  // The Worker is the whole origin — the pages come from the asset binding and
  // `/api/pdf` from the Worker — so the hostname is a custom domain rather than
  // a route. Cloudflare writes the DNS record and the certificate on deploy.
  "routes": [
    {
      "pattern": "fridgeweek.com",
      "custom_domain": true
    }
  ],

  // One site, one hostname. Set to true to reach a deploy before DNS resolves.
  "workers_dev": false,

  // The earliest date that supports Browser Rendering quick actions. Moving it
  // forward is a deliberate act, not something that drifts.
  // https://developers.cloudflare.com/browser-rendering/quick-actions/
  "compatibility_date": "2026-03-24",

  // What Astro's Cloudflare adapter asks for; it adds `nodejs_als` itself.
  "compatibility_flags": ["nodejs_compat"],

  // `main` and the asset binding are filled in by @astrojs/cloudflare at build
  // time, so they are deliberately absent here.

  // Headless Chromium, used by src/lib/pdf/cloudflare.ts. The only part of
  // Fridgeweek that costs money; see docs/DEPLOYING.md.
  // https://developers.cloudflare.com/browser-rendering/workers-bindings/
  "browser": {
    "binding": "BROWSER"
  },

  // Five PDF requests a minute per client IP, which is what bounds the spend
  // above. `namespace_id` is any number unique within this Worker, not an
  // account identifier. `period` may only be 10 or 60, and must match
  // RATE_LIMIT_PERIOD_SECONDS in src/lib/pdf/limits.ts, which is what the
  // Retry-After header promises.
  // https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
  "ratelimits": [
    {
      "name": "PDF_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
