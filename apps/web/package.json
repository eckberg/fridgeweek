{
  "name": "@fridgeweek/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "pnpm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "preview": "astro preview",
    "typecheck": "astro check --minimum-severity error && vue-tsc --noEmit -p tsconfig.vue.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/vue": "^7.0.2",
    "@fridgeweek/core": "workspace:*",
    "astro": "^7.3.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.0",
    "playwright-core": "1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "3.1.4",
    "wrangler": "^4.129.0"
  }
}
